{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas.local/schemas/v1/incremental-batch-plan.schema.json",
  "title": "Atlas deterministic multi-target incremental batch plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "batchPlanId", "planner", "plans"],
  "properties": {
    "schemaVersion": { "$ref": "common.schema.json#/$defs/schemaVersion" },
    "batchPlanId": { "type": "string", "pattern": "^incremental_batch_sha256_[a-f0-9]{64}$" },
    "planner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "const": "atlas/incremental-planner" },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "plans": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "incremental-plan.schema.json" }
    }
  }
}
