{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas.local/schemas/v1/historical-evidence-record.schema.json",
  "title": "Atlas immutable historical-evidence navigation record v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "kind",
    "artifact",
    "title",
    "titleLine",
    "scopeAnchors",
    "pathAnchors",
    "reviewerIdentity",
    "anchorFreshness",
    "interpretation"
  ],
  "properties": {
    "schemaVersion": { "$ref": "common.schema.json#/$defs/schemaVersion" },
    "id": { "$ref": "historical-evidence-common.schema.json#/$defs/recordId" },
    "kind": { "enum": ["review", "trace"] },
    "artifact": { "$ref": "historical-evidence-common.schema.json#/$defs/artifact" },
    "title": { "type": "string", "minLength": 1 },
    "titleLine": { "type": "integer", "minimum": 1 },
    "scopeAnchors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["heading", "level", "line", "column"],
        "properties": {
          "heading": { "type": "string", "minLength": 1 },
          "level": { "type": "integer", "minimum": 1, "maximum": 6 },
          "line": { "type": "integer", "minimum": 1 },
          "column": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "pathAnchors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "kind", "mentions"],
        "properties": {
          "path": { "$ref": "common.schema.json#/$defs/relativePath" },
          "kind": { "enum": ["file", "directory-or-pattern"] },
          "targetStartLine": { "type": "integer", "minimum": 1 },
          "targetEndLine": { "type": "integer", "minimum": 1 },
          "mentions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["line", "column"],
              "properties": {
                "line": { "type": "integer", "minimum": 1 },
                "column": { "type": "integer", "minimum": 1 }
              }
            }
          }
        },
        "dependentRequired": {
          "targetStartLine": ["targetEndLine"],
          "targetEndLine": ["targetStartLine"]
        },
        "allOf": [
          {
            "if": {
              "properties": { "targetStartLine": { "type": "integer", "minimum": 1 } },
              "required": ["targetStartLine"]
            },
            "then": { "properties": { "kind": { "const": "file" } } }
          }
        ]
      }
    },
    "reviewerIdentity": { "$ref": "historical-evidence-common.schema.json#/$defs/reviewerIdentity" },
    "anchorFreshness": { "$ref": "historical-evidence-common.schema.json#/$defs/anchorFreshness" },
    "interpretation": { "$ref": "historical-evidence-common.schema.json#/$defs/interpretation" },
    "trace": { "$ref": "historical-evidence-common.schema.json#/$defs/trace" }
  },
  "allOf": [
    {
      "if": { "properties": { "kind": { "const": "trace" } }, "required": ["kind"] },
      "then": {
        "properties": { "trace": { "$ref": "historical-evidence-common.schema.json#/$defs/trace" } },
        "required": ["trace"]
      },
      "else": { "properties": { "trace": false } }
    }
  ]
}
