{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas.local/schemas/v1/finding-disposition-ledger.schema.json",
  "title": "Atlas finding disposition ledger v1",
  "$defs": {
    "anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "$ref": "common.schema.json#/$defs/relativePath" },
        "sha256": { "$ref": "common.schema.json#/$defs/sha256" }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["findingId", "disposition", "reviewer", "date", "evidence", "anchors"],
      "properties": {
        "findingId": { "$ref": "common.schema.json#/$defs/findingId" },
        "disposition": {
          "enum": [
            "confirmed defect",
            "intentional contract",
            "false positive/profile gap",
            "test fixture",
            "framework-managed/external entrypoint",
            "obsolete but cleanup separately",
            "needs runtime/schema evidence",
            "defer"
          ]
        },
        "reviewer": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "\\S" },
        "date": { "type": "string", "format": "date" },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 4096, "pattern": "\\S" }
        },
        "anchors": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/anchor" }
        }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "targetId", "profileId", "profileDigest", "entries"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "$ref": "common.schema.json#/$defs/schemaVersion" },
    "kind": { "const": "atlas-finding-disposition-ledger" },
    "targetId": { "$ref": "common.schema.json#/$defs/targetId" },
    "profileId": { "type": "string", "minLength": 1 },
    "profileDigest": { "$ref": "common.schema.json#/$defs/sha256" },
    "entries": {
      "type": "object",
      "maxProperties": 25000,
      "propertyNames": {
        "type": "string",
        "pattern": "^finding_review_sha256_[a-f0-9]{64}(?::occurrence:[1-9][0-9]*)?$"
      },
      "additionalProperties": { "$ref": "#/$defs/entry" }
    }
  }
}
