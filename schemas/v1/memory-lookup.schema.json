{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas.local/schemas/v1/memory-lookup.schema.json",
  "title": "Atlas permission-bound cited memory response v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "targetId", "runId", "snapshotId", "query", "answer", "freshness", "coverage", "authorization", "hits", "truncated"],
  "properties": {
    "schemaVersion": { "$ref": "common.schema.json#/$defs/schemaVersion" },
    "targetId": { "$ref": "common.schema.json#/$defs/targetId" },
    "runId": { "$ref": "common.schema.json#/$defs/runId" },
    "snapshotId": { "$ref": "common.schema.json#/$defs/snapshotId" },
    "query": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "answer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "text"],
      "properties": {
        "kind": { "enum": ["matches", "abstention"] },
        "text": { "type": "string", "minLength": 1 }
      }
    },
    "freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "currentSnapshotId", "currentDiscoveryDigest", "reasons", "addedPaths", "changedPaths", "removedPaths"],
      "properties": {
        "status": { "enum": ["current", "stale"] },
        "currentSnapshotId": { "$ref": "common.schema.json#/$defs/snapshotId" },
        "currentDiscoveryDigest": { "$ref": "common.schema.json#/$defs/sha256" },
        "reasons": { "type": "array", "items": { "enum": ["snapshot-bytes", "git-provenance"] }, "uniqueItems": true },
        "addedPaths": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/relativePath" }, "uniqueItems": true },
        "changedPaths": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/relativePath" }, "uniqueItems": true },
        "removedPaths": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/relativePath" }, "uniqueItems": true }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["files", "relationships", "findings", "diagnostics", "boundaryDiagnosticCodes", "unsupportedDiagnosticCodes", "discoveryState", "discoveryDiagnosticCodes"],
      "properties": {
        "files": { "type": "integer", "minimum": 0 },
        "relationships": { "type": "integer", "minimum": 0 },
        "findings": { "type": "integer", "minimum": 0 },
        "diagnostics": { "type": "integer", "minimum": 0 },
        "boundaryDiagnosticCodes": { "type": "array", "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" }, "uniqueItems": true },
        "unsupportedDiagnosticCodes": { "type": "array", "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" }, "uniqueItems": true },
        "discoveryState": { "enum": ["ready", "partial", "not-git", "unsupported"] },
        "discoveryDiagnosticCodes": { "type": "array", "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" }, "uniqueItems": true }
      }
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "projectMemoryConsent", "sourceContentIncluded", "secretValuesCollected"],
      "properties": {
        "scope": { "const": "registered-local-target" },
        "projectMemoryConsent": { "const": true },
        "sourceContentIncluded": { "const": false },
        "secretValuesCollected": { "const": false }
      }
    },
    "hits": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "id", "score", "label", "evidence"],
        "properties": {
          "kind": { "enum": ["file", "relationship", "finding", "diagnostic"] },
          "id": { "type": "string", "minLength": 1 },
          "score": { "type": "number", "minimum": 0 },
          "label": { "type": "string", "minLength": 1 },
          "path": { "$ref": "common.schema.json#/$defs/relativePath" },
          "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/evidence" } }
        }
      }
    },
    "truncated": { "type": "boolean" }
  }
}
