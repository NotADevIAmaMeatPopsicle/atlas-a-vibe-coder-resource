{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas.local/schemas/v1/review-campaign.schema.json",
  "title": "Atlas review campaign v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "campaignId", "runId", "snapshotId", "purpose", "state", "selection", "batchSize", "packetIds", "fileCount", "estimatedInputTokens"],
  "properties": {
    "schemaVersion": { "$ref": "common.schema.json#/$defs/schemaVersion" },
    "campaignId": { "$ref": "common.schema.json#/$defs/campaignId" },
    "runId": { "$ref": "common.schema.json#/$defs/runId" },
    "snapshotId": { "$ref": "common.schema.json#/$defs/snapshotId" },
    "purpose": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "state": { "const": "queued" },
    "selection": { "enum": ["all", "findings", "paths", "symbols", "diff", "neighborhood"] },
    "selectionSpec": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "selectors": {
          "type": "array",
          "minItems": 1,
          "maxItems": 25000,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 4096 }
        },
        "depth": { "type": "integer", "minimum": 0, "maximum": 8 },
        "direction": { "enum": ["incoming", "outgoing", "both"] },
        "baselineRunId": { "$ref": "common.schema.json#/$defs/runId" },
        "baselineSnapshotId": { "$ref": "common.schema.json#/$defs/snapshotId" },
        "incrementalPlanId": { "type": "string", "pattern": "^incremental_plan_sha256_[a-f0-9]{64}$" }
      }
    },
    "batchSize": { "type": "integer", "minimum": 1, "maximum": 500 },
    "packetIds": { "type": "array", "maxItems": 25000, "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/packetId" } },
    "fileCount": { "type": "integer", "minimum": 0 },
    "estimatedInputTokens": { "type": "integer", "minimum": 0 }
  }
}
