{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas.local/schemas/v1/review-result.schema.json",
  "title": "Atlas canonical review result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "resultId", "executionId", "runId", "snapshotId", "campaignId", "packetId", "packetHash", "attemptId", "reviewer", "evidenceFiles", "reviewedFiles", "responsibilities", "associations", "observed", "suspected", "needsRuntimeValidation", "unknowns", "usage"],
  "properties": {
    "schemaVersion": { "$ref": "common.schema.json#/$defs/schemaVersion" },
    "resultId": { "type": "string", "pattern": "^review_result_[a-f0-9]{64}$" },
    "executionId": { "type": "string", "pattern": "^review_execution_[a-f0-9]{64}$" },
    "runId": { "$ref": "common.schema.json#/$defs/runId" },
    "snapshotId": { "$ref": "common.schema.json#/$defs/snapshotId" },
    "campaignId": { "$ref": "common.schema.json#/$defs/campaignId" },
    "packetId": { "$ref": "common.schema.json#/$defs/packetId" },
    "packetHash": { "$ref": "common.schema.json#/$defs/sha256" },
    "attemptId": { "type": "string", "pattern": "^review_attempt_[a-f0-9]{64}$" },
    "reviewer": { "$ref": "review-execution-attempt.schema.json#/$defs/reviewer" },
    "evidenceFiles": { "$ref": "#/$defs/fileTuples" },
    "reviewedFiles": { "$ref": "#/$defs/fileTuples" },
    "responsibilities": { "$ref": "#/$defs/statements" },
    "associations": { "$ref": "#/$defs/statements" },
    "observed": { "$ref": "#/$defs/statements" },
    "suspected": { "$ref": "#/$defs/statements" },
    "needsRuntimeValidation": { "$ref": "#/$defs/statements" },
    "unknowns": { "$ref": "#/$defs/statements" },
    "usage": { "$ref": "review-execution-attempt.schema.json#/$defs/usage" }
  },
  "$defs": {
    "fileTuple": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "sha256", "bytes"],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/fileId" },
        "path": { "$ref": "common.schema.json#/$defs/relativePath" },
        "sha256": { "$ref": "common.schema.json#/$defs/sha256" },
        "bytes": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
      }
    },
    "fileTuples": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 500,
      "items": { "$ref": "#/$defs/fileTuple" }
    },
    "anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fileId", "path", "sha256"],
      "properties": {
        "fileId": { "$ref": "common.schema.json#/$defs/fileId" },
        "path": { "$ref": "common.schema.json#/$defs/relativePath" },
        "sha256": { "$ref": "common.schema.json#/$defs/sha256" },
        "line": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "column": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }
      },
      "dependentRequired": { "line": ["column"], "column": ["line"] }
    },
    "statement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "confidence", "evidence"],
      "properties": {
        "summary": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "confidence": { "enum": ["confirmed", "high", "medium", "low", "unknown"] },
        "evidence": { "type": "array", "uniqueItems": true, "maxItems": 1000, "items": { "$ref": "#/$defs/anchor" } }
      }
    },
    "statements": {
      "type": "array",
      "maxItems": 1000,
      "items": { "$ref": "#/$defs/statement" }
    }
  }
}
