{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas.local/schemas/v1/changed-findings.schema.json",
  "title": "Atlas changed-path finding report v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "reportId", "kind", "producer", "target", "run", "comparison", "changedPaths", "counts", "matchingFindings"],
  "allOf": [
    {
      "if": {
        "type": "object",
        "required": ["producer"],
        "properties": {
          "producer": {
            "type": "object",
            "required": ["version"],
            "properties": { "version": { "const": "1.1.0" } }
          }
        }
      },
      "then": {
        "type": "object",
        "required": ["matchingDispositions"],
        "properties": {
          "matchingDispositions": true,
          "counts": {
            "type": "object",
            "required": ["matchingDispositions"],
            "properties": { "matchingDispositions": true }
          }
        }
      }
    }
  ],
  "properties": {
    "schemaVersion": { "$ref": "common.schema.json#/$defs/schemaVersion" },
    "reportId": { "type": "string", "pattern": "^changed_findings_sha256_[a-f0-9]{64}$" },
    "kind": { "const": "atlas-changed-findings-report" },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "const": "atlas/changed-findings" },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": { "id": { "$ref": "common.schema.json#/$defs/targetId" } }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runId", "snapshotId", "artifactManifestDigest"],
      "properties": {
        "runId": { "$ref": "common.schema.json#/$defs/runId" },
        "snapshotId": { "$ref": "common.schema.json#/$defs/snapshotId" },
        "artifactManifestDigest": { "$ref": "common.schema.json#/$defs/sha256" }
      }
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requestedRef", "resolvedCommit", "headCommit"],
      "properties": {
        "requestedRef": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "resolvedCommit": { "type": "string", "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$" },
        "headCommit": { "type": "string", "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$" }
      }
    },
    "changedPaths": { "$ref": "#/$defs/pathArray" },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["changedPaths", "runFindings", "matchingFindings", "matchingFindingInstances"],
      "properties": {
        "changedPaths": { "type": "integer", "minimum": 0 },
        "runFindings": { "type": "integer", "minimum": 0 },
        "matchingFindings": { "type": "integer", "minimum": 0 },
        "matchingFindingInstances": { "type": "integer", "minimum": 0 },
        "matchingDispositions": { "type": "integer", "minimum": 0 }
      }
    },
    "matchingFindings": {
      "type": "array",
      "items": { "$ref": "#/$defs/match" }
    },
    "matchingDispositions": {
      "type": "array",
      "items": { "$ref": "#/$defs/dispositionMatch" }
    }
  },
  "$defs": {
    "pathArray": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "common.schema.json#/$defs/relativePath" }
    },
    "match": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewIdentity", "matchedPaths", "finding"],
      "properties": {
        "reviewIdentity": { "type": "string", "pattern": "^finding_review_sha256_[a-f0-9]{64}$" },
        "matchedPaths": {
          "allOf": [
            { "$ref": "#/$defs/pathArray" },
            { "type": "array", "minItems": 1 }
          ]
        },
        "finding": { "$ref": "finding.schema.json" }
      }
    },
    "dispositionMatch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewId", "findingId", "disposition", "reviewer", "date", "evidence", "anchors", "state", "matchedPaths"],
      "properties": {
        "reviewId": { "type": "string", "pattern": "^finding_review_sha256_[a-f0-9]{64}(?::occurrence:[1-9][0-9]*)?$" },
        "findingId": { "$ref": "common.schema.json#/$defs/findingId" },
        "title": { "type": "string", "minLength": 1 },
        "ruleId": { "type": "string", "minLength": 1 },
        "disposition": {
          "enum": [
            "confirmed defect",
            "intentional contract",
            "false positive/profile gap",
            "test fixture",
            "framework-managed/external entrypoint",
            "obsolete but cleanup separately",
            "needs runtime/schema evidence",
            "defer"
          ]
        },
        "reviewer": { "type": "string", "minLength": 1 },
        "date": { "type": "string", "format": "date" },
        "evidence": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "anchors": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "sha256"],
            "properties": {
              "path": { "$ref": "common.schema.json#/$defs/relativePath" },
              "sha256": { "$ref": "common.schema.json#/$defs/sha256" }
            }
          }
        },
        "state": { "const": "applied" },
        "matchedPaths": {
          "allOf": [
            { "$ref": "#/$defs/pathArray" },
            { "type": "array", "minItems": 1 }
          ]
        }
      }
    }
  }
}
