{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas.local/schemas/v1/analysis-health.schema.json",
  "title": "Atlas analysis-health record v1",
  "$defs": {
    "count": { "type": "integer", "minimum": 0 },
    "ratio": {
      "type": "object",
      "additionalProperties": false,
      "required": ["numerator", "denominator"],
      "properties": {
        "numerator": { "$ref": "#/$defs/count" },
        "denominator": { "$ref": "#/$defs/count" }
      }
    },
    "syntheticRatio": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tier", "numerator", "denominator"],
      "properties": {
        "tier": { "const": "synthetic" },
        "numerator": { "$ref": "#/$defs/count" },
        "denominator": { "$ref": "#/$defs/count" }
      }
    },
    "realTargetEvaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tier", "result", "reportContract"],
      "properties": {
        "tier": { "const": "real-target" },
        "result": { "const": "not-recorded-in-run" },
        "reportContract": { "const": "real-target-corpus-report.schema.json" }
      }
    },
    "profilePattern": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "collection", "pattern", "expected", "observed", "status"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "\\S" },
        "collection": {
          "enum": ["include-root", "exclude", "entrypoint", "dead-code-exemption", "fixture-boundary", "guard-boundary", "seed-dictionary-source", "loader-root"]
        },
        "pattern": { "type": "string", "minLength": 1, "maxLength": 4096, "pattern": "\\S" },
        "expected": {
          "type": "object",
          "additionalProperties": false,
          "required": ["minimum"],
          "properties": {
            "minimum": { "$ref": "#/$defs/count" },
            "maximum": { "$ref": "#/$defs/count" }
          }
        },
        "observed": { "$ref": "#/$defs/count" },
        "status": { "enum": ["passed", "failed"] },
        "samplePaths": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "$ref": "common.schema.json#/$defs/relativePath" }
        }
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ruleId", "state", "controls"],
      "properties": {
        "ruleId": { "type": "string", "minLength": 1, "maxLength": 512, "pattern": "\\S" },
        "state": { "enum": ["enabled", "disabled"] },
        "controls": {
          "type": "object",
          "additionalProperties": false,
          "required": ["total", "passed", "failed", "expectedObservations", "observedObservations"],
          "properties": {
            "total": { "$ref": "#/$defs/count" },
            "passed": { "$ref": "#/$defs/count" },
            "failed": { "$ref": "#/$defs/count" },
            "expectedObservations": { "$ref": "#/$defs/count" },
            "observedObservations": { "$ref": "#/$defs/count" }
          }
        },
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": ["detectedObservations", "uncertainObservations", "findingInstances"],
          "properties": {
            "inputStatus": { "enum": ["complete", "incomplete"] },
            "detectedObservations": { "$ref": "#/$defs/count" },
            "uncertainObservations": { "$ref": "#/$defs/count" },
            "findingInstances": { "$ref": "#/$defs/count" },
            "suppressedFindingInstances": { "$ref": "#/$defs/count" },
            "expectations": {
              "type": "object",
              "additionalProperties": false,
              "minProperties": 1,
              "properties": {
                "minimumDetectedObservations": { "$ref": "#/$defs/count" },
                "maximumPossibleObservations": { "$ref": "#/$defs/count" },
                "minimumFindingInstances": { "$ref": "#/$defs/count" },
                "maximumFindingInstances": { "$ref": "#/$defs/count" }
              }
            }
          }
        }
      }
    },
    "brokenOutcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expectedMinimum", "observed", "outcome"],
      "properties": {
        "expectedMinimum": { "type": "integer", "minimum": 1 },
        "observed": { "$ref": "#/$defs/count" },
        "outcome": { "enum": ["detected", "missed", "not-evaluated"] }
      }
    },
    "fixedOutcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expectedMaximum", "observed", "outcome"],
      "properties": {
        "expectedMaximum": { "type": "integer", "const": 0 },
        "observed": { "$ref": "#/$defs/count" },
        "outcome": { "enum": ["silent", "regressed", "not-evaluated"] }
      }
    },
    "incident": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "family", "ruleId", "mechanismId", "broken", "fixed", "status"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "\\S" },
        "family": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "\\S" },
        "ruleId": { "type": "string", "minLength": 1, "maxLength": 512, "pattern": "\\S" },
        "mechanismId": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "\\S" },
        "broken": { "$ref": "#/$defs/brokenOutcome" },
        "fixed": { "$ref": "#/$defs/fixedOutcome" },
        "status": { "enum": ["passed", "failed", "unsupported"] }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "snapshotId",
    "producer",
    "catalogDigest",
    "corpusDigest",
    "status",
    "profilePatterns",
    "rules",
    "incidents",
    "recall",
    "fixedCaseSilence"
  ],
  "properties": {
    "schemaVersion": { "$ref": "common.schema.json#/$defs/schemaVersion" },
    "runId": { "$ref": "common.schema.json#/$defs/runId" },
    "snapshotId": { "$ref": "common.schema.json#/$defs/snapshotId" },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "const": "atlas/analysis-health" },
        "version": { "type": "string", "pattern": "^1(?:\\.[0-9]+){2}(?:[-+][0-9A-Za-z.-]+)?$" }
      }
    },
    "catalogDigest": { "$ref": "common.schema.json#/$defs/sha256" },
    "corpusDigest": { "$ref": "common.schema.json#/$defs/sha256" },
    "status": { "enum": ["complete", "incomplete"] },
    "profilePatterns": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100000,
      "items": { "$ref": "#/$defs/profilePattern" }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100000,
      "items": { "$ref": "#/$defs/rule" }
    },
    "incidents": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100000,
      "items": { "$ref": "#/$defs/incident" }
    },
    "recall": {
      "oneOf": [
        { "$ref": "#/$defs/ratio" },
        { "$ref": "#/$defs/syntheticRatio" }
      ]
    },
    "realTargetEvaluation": { "$ref": "#/$defs/realTargetEvaluation" },
    "fixedCaseSilence": { "$ref": "#/$defs/ratio" }
  },
  "allOf": [{
    "if": {
      "type": "object",
      "properties": {
        "producer": {
          "type": "object",
          "properties": { "version": { "const": "1.3.2" } },
          "required": ["version"]
        }
      }
    },
    "then": {
      "type": "object",
      "required": ["realTargetEvaluation"],
      "properties": {
        "recall": { "$ref": "#/$defs/syntheticRatio" },
        "realTargetEvaluation": { "$ref": "#/$defs/realTargetEvaluation" }
      }
    },
    "else": {
      "type": "object",
      "properties": {
        "recall": { "$ref": "#/$defs/ratio" },
        "realTargetEvaluation": false
      }
    }
  }]
}
