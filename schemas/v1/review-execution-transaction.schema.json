{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas.local/schemas/v1/review-execution-transaction.schema.json",
  "title": "Atlas review execution transaction v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "transactionId", "transactionNonce", "executionId", "campaignId", "fromRevision", "toRevision", "operations"],
  "properties": {
    "schemaVersion": { "$ref": "common.schema.json#/$defs/schemaVersion" },
    "transactionId": { "type": "string", "pattern": "^review_transaction_[a-f0-9]{64}$" },
    "transactionNonce": { "type": "string", "pattern": "^[a-f0-9]{32}$" },
    "executionId": { "type": "string", "pattern": "^review_execution_[a-f0-9]{64}$" },
    "campaignId": { "$ref": "common.schema.json#/$defs/campaignId" },
    "fromRevision": { "$ref": "#/$defs/nonNegativeInteger" },
    "toRevision": { "$ref": "#/$defs/nonNegativeInteger" },
    "operations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "recordId", "expectedHash", "pre", "postHash", "post"],
        "properties": {
          "kind": { "enum": ["attempt", "result", "execution"] },
          "recordId": { "type": "string", "minLength": 1, "maxLength": 256 },
          "expectedHash": {
            "oneOf": [
              { "type": "null" },
              { "$ref": "common.schema.json#/$defs/sha256" }
            ]
          },
          "pre": {
            "oneOf": [
              { "type": "null" },
              { "type": "string", "minLength": 1, "maxLength": 16777216 }
            ]
          },
          "postHash": { "$ref": "common.schema.json#/$defs/sha256" },
          "post": { "type": "string", "minLength": 1, "maxLength": 16777216 }
        }
      }
    }
  },
  "$defs": {
    "nonNegativeInteger": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
  }
}
