{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas.local/schemas/v1/artifact-manifest.schema.json",
  "title": "Atlas deterministic artifact digest manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "runId", "artifacts"],
  "properties": {
    "schemaVersion": { "$ref": "common.schema.json#/$defs/schemaVersion" },
    "runId": { "$ref": "common.schema.json#/$defs/runId" },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "bytes", "sha256"],
        "properties": {
          "path": { "$ref": "common.schema.json#/$defs/relativePath" },
          "bytes": { "type": "integer", "minimum": 0 },
          "sha256": { "$ref": "common.schema.json#/$defs/sha256" }
        }
      }
    }
  }
}
